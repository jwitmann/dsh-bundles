{
  "name": "@local/dsh-command-review",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Slash command /review that delegates document review to a subagent.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
